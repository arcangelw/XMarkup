# SwiftFormat 配置
--swiftversion 6.0

# 缩进
--indent 4
--tabwidth 4
--smarttabs enabled
--indentcase false

# 空白
--trimwhitespace always
--ranges spaced

# 风格
--self remove
--voidtype void
--commas always
--semicolons never
--exponentcase lowercase
--decimalgrouping 3,6

# 组织
--header ignore
--ifdef indent
--importgrouping alpha
--stripunusedargs closure-only
--wraparguments before-first
--wrapcollections before-first

# 排除规则（Swift 6 兼容）
--disable redundantSelf
